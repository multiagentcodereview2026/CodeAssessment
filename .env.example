# Copy to .env and replace both values with independent, random URL-safe secrets.
POSTGRES_PASSWORD=replace-with-random-hex-secret
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional: set this to an external PostgreSQL URL to bypass the bundled DB.
# Leave unset to use the PostgreSQL service from docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Optional runner settings.
# PUBLIC_ONLY_EXECUTION=false
# EXECUTION_SANDBOX_VOLUME=codeassessment_execution-work
# Production deployments must set this to the exact trusted frontend origins.
# CORS_ALLOW_ORIGINS=https://assessment.example.edu

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long

# Development-only account provisioning. Set these explicitly before running
# `python seed_dev_instructor.py`; do not commit real values.
DEV_INSTRUCTOR_USERNAME=
DEV_INSTRUCTOR_EMAIL=
DEV_INSTRUCTOR_PASSWORD=
DEV_INSTRUCTOR_FULL_NAME=
# Only set true when intentionally rotating an existing dev account password.
DEV_INSTRUCTOR_RESET_PASSWORD=false

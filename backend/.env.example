# ===================================================
# Explainable Multi-Agent AI Code Evaluator Environment
# ===================================================

# Get your free Groq API key at: https://console.groq.com
GROQ_API_KEY=your_free_groq_api_key_here

# Groq Model Selection (Free Fast Inference)
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./evaluator.db

# Execution Sandbox Settings
DOCKER_EXECUTION_TIMEOUT=5
MAX_MEMORY_MB=256

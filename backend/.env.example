# Copy to backend/.env and set your private API key locally.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_ALLOWED_CAPABILITIES=explainability,revision,score_projection,complexity_review
GROQ_TIMEOUT_SECONDS=90
# Keep submission results responsive when the optional provider is rate-limited.
# Set a positive value only when deliberately accepting a longer wait for retries.
GROQ_MAX_RETRIES=0
GROQ_MIN_REQUEST_INTERVAL_SECONDS=15
GROQ_RATE_LIMIT_RETRIES=0

# Requested guided revision and private score projection.
SCORE_PROJECTION_ENABLED=true
SCORE_PROJECTION_MIN_GAIN=1.0
# Percentage points of style score (1 point = 0.1 total marks at 10% weight).
SCORE_PROJECTION_STYLE_TOLERANCE=1.0
GUIDED_REVISION_TIMEOUT_SECONDS=12
SCORE_PROJECTION_TIMEOUT_SECONDS=95
SCORE_PROJECTION_MAX_DRAFT_ATTEMPTS=1
SCORE_PROJECTION_BACKGROUND_RETRIES=1
SCORE_PROJECTION_RETRY_DELAY_SECONDS=120
REVISION_DAILY_JOB_LIMIT=3
REVISION_JOB_CONCURRENCY=1
REVISION_JOB_TTL_SECONDS=3600
SCORE_PROJECTION_JUDGE_TIMEOUT_SECONDS=180

# Confident AST results bypass AI; review uncertain results only.
COMPLEXITY_AI_REVIEW_ENABLED=true
COMPLEXITY_AST_DIRECT_CONFIDENCE=0.85
COMPLEXITY_AI_MIN_CONFIDENCE=0.70
COMPLEXITY_AI_REQUESTS_PER_MINUTE=12
COMPLEXITY_AI_MAX_CONCURRENCY=2
COMPLEXITY_AI_CACHE_TTL_SECONDS=3600

# Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD in root .env
# when root DATABASE_URL is blank. Its database user is codeassessment.
# For running the backend directly, supply your own database connection here.
DATABASE_URL=
# Docker Compose supplies this from root .env. For direct backend startup,
# set the same private secret here; never share or commit a real secret.
JWT_SECRET_KEY=

# Development-only account provisioning. Set these explicitly before running
# `python seed_dev_instructor.py`; do not commit real values.
DEV_INSTRUCTOR_USERNAME=
DEV_INSTRUCTOR_EMAIL=
DEV_INSTRUCTOR_PASSWORD=
DEV_INSTRUCTOR_FULL_NAME=
# Only set true when intentionally rotating an existing dev account password.
DEV_INSTRUCTOR_RESET_PASSWORD=false
